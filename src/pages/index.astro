---
// Q2See — Quote-to-Cash Flow Inspector
// Static page; synthetic data loaded client-side from /q2see/data/.
// Real backend: import-capable, posts to /q2see/analyze (Cloudflare Pages Function).
import '../styles/q2see.css';
import GuidedTour from '../components/demo/GuidedTour.astro';
import { GUIDED_TOURS } from '../data/guidedTours';
const title = 'Q2See — inspect a quote-to-cash flow record by record';
const description = 'Import a quote-to-cash export and trace where the handoff broke, from quote through renewal.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600;700&family=Geist+Mono:wght@400;500;600&display=swap" />
  </head>
  <body>
    <div class="q2-root q2-shell" id="q2-app">

      <!-- Nav -->
      <nav class="q2-nav" aria-label="Q2See navigation">
        <span class="q2-nav-logo">q2see</span>
        <span class="q2-nav-sep" aria-hidden="true"></span>
        <span class="q2-nav-label">Quote-to-Cash Flow Inspector</span>
        <span class="q2-nav-spacer"></span>
        <button class="q2-nav-import" id="q2-import-toggle" aria-expanded="false" aria-controls="q2-import-panel">Import your data</button>
        <span class="q2-nav-badge q2-nav-badge--live">live backend</span>
        <span class="q2-nav-badge" id="q2-nav-mode-badge">synthetic · demo</span>
      </nav>

      <!-- Import panel — real backend (POST /q2see/analyze) -->
      <div class="q2-import-panel hidden" id="q2-import-panel" role="region" aria-label="Import a Quote-to-Cash export">
        <div class="q2-import-head">
          <strong>Inspect your own pipeline.</strong>
          Upload a CSV of your deals (one row per deal, with quote / contract / invoice / renewal columns).
          The server maps contract → quote → invoice → renewal and flags every broken handoff in <em>your</em> rows.
          Nothing is stored, and there is no live CRM connection — just the file you provide.
        </div>
        <div class="q2-import-controls">
          <label class="q2-import-filebtn">
            Choose CSV / JSON
            <input type="file" id="q2-import-file" accept=".csv,.json,text/csv,application/json" hidden />
          </label>
          <button class="q2-import-btn" id="q2-import-sample" type="button">Load sample export</button>
          <a class="q2-import-link" href="/q2see/sample-q2c-export.csv" download>Download sample CSV</a>
        </div>
        <textarea id="q2-import-text" class="q2-import-text" rows="5" spellcheck="false"
          placeholder="Or paste CSV or JSON here — header row, one row per deal."></textarea>
        <div class="q2-import-actions">
          <button class="q2-import-btn q2-import-btn--primary" id="q2-import-analyze" type="button">Analyze export</button>
          <span class="q2-import-status" id="q2-import-status" role="status"></span>
        </div>
      </div>

      <!-- Synthetic data banner -->
      <div class="q2-banner" id="q2-banner" role="status">
        <span class="q2-banner-icon">DEMO</span>
        <p class="q2-banner-text">
          <strong>Demo data — the breaks are real, the account names aren't.</strong>
          Every finding here was planted from a pattern that shows up in real quote-to-cash systems. The company names are fictional; the failure modes are not. Day counts (for example, “77 days unbilled”) are measured from a fixed May 30, 2026 snapshot, not today.
        </p>
        <button class="q2-banner-dismiss" aria-label="Dismiss banner" id="q2-banner-dismiss">×</button>
      </div>

      <GuidedTour {...GUIDED_TOURS.q2see} />

      <!-- Filter bar -->
      <div class="q2-filter-bar" role="toolbar" aria-label="Filter findings">
        <span class="q2-filter-label">Severity</span>
        <button class="q2-filter-pill" data-severity="critical" aria-pressed="false">Critical</button>
        <button class="q2-filter-pill" data-severity="warning" aria-pressed="false">Warning</button>
        <button class="q2-filter-pill" data-severity="at-risk" aria-pressed="false">At Risk</button>
        <div class="q2-filter-divider" aria-hidden="true"></div>
        <span class="q2-filter-label">Stage</span>
        <button class="q2-filter-pill" data-type="contract" aria-pressed="false">Contracts</button>
        <button class="q2-filter-pill" data-type="invoice" aria-pressed="false">Invoices</button>
        <button class="q2-filter-pill" data-type="renewal" aria-pressed="false">Renewals</button>
      </div>

      <!-- Main layout: graph + inspector -->
      <div class="q2-layout" id="q2-layout">

        <!-- Graph canvas -->
        <div class="q2-graph-wrap" id="q2-graph-wrap" role="main" aria-label="Quote-to-Cash flow graph">
          <div class="q2-graph-canvas-wrap">
            <svg id="q2-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Quote-to-cash flow graph — five stages: Opportunity, Quote, Contract, Invoice, Renewal" preserveAspectRatio="none">
              <g id="q2-graph-g"></g>
            </svg>
          </div>

          <!-- Zoom controls -->
          <div class="q2-zoom-controls" aria-label="Zoom controls">
            <button class="q2-zoom-btn" id="q2-zoom-in" aria-label="Zoom in" title="Zoom in">+</button>
            <button class="q2-zoom-btn" id="q2-zoom-reset" aria-label="Reset zoom" title="Reset view" style="font-size:11px">⌖</button>
            <button class="q2-zoom-btn" id="q2-zoom-out" aria-label="Zoom out" title="Zoom out">−</button>
          </div>
        </div>

        <!-- Inspector panel — fully JS-driven -->
        <section class="q2-inspector hidden" id="q2-inspector" aria-label="Record inspector">
          <div class="q2-inspector-header" id="q2-inspector-header">
            <div id="q2-inspector-header-inner">
              <div class="q2-inspector-severity healthy">● SELECT A NODE</div>
              <div class="q2-inspector-title">Click any node in the graph</div>
            </div>
            <button class="q2-inspector-close" id="q2-inspector-close" aria-label="Close inspector">×</button>
          </div>
          <div class="q2-inspector-body" id="q2-inspector-body">
            <p class="q2-inspector-empty">
              Red nodes have active findings. The Crestline Digital contract is pre-selected on load.
            </p>
          </div>
        </section>

      </div><!-- /.q2-layout -->

      <!-- Findings rail -->
      <div class="q2-findings-rail" id="q2-findings-rail" role="navigation" aria-label="Active findings">
        <div class="q2-rail-header">
          <span class="q2-rail-header-text">Active Findings</span>
        </div>
        <div class="q2-findings-list" id="q2-findings-list" role="list" aria-label="Finding cards">
          <!-- Populated by JS -->
          <div style="display:flex;align-items:center;padding:0 1rem;color:oklch(55% 0.01 250);font-size:11px">Loading findings…</div>
        </div>
      </div>

    </div><!-- /#q2-app -->

    <script>
      import '../components/app.ts';
    </script>
  </body>
</html>
