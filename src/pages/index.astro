---
// Q2See — Quote-to-Cash Flow Inspector
// Static page; all data loaded client-side from /q2see/data/
import '../styles/q2see.css';
const title = "Q2See — Signed contract. No invoice. Nobody's panicking yet. They will be.";
const description = "One flow graph. Every broken handoff. Before legal finds it first. Q2See inspects your Quote-to-Cash pipeline at the record level — contract, quote, invoice, renewal — and surfaces exactly where the plumbing broke.";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <div class="q2-root q2-shell" id="q2-app">

      <!-- Nav -->
      <nav class="q2-nav" aria-label="Q2See navigation">
        <span class="q2-nav-logo">q2see</span>
        <span class="q2-nav-sep" aria-hidden="true"></span>
        <span class="q2-nav-label">Quote-to-Cash Flow Inspector</span>
        <span class="q2-nav-spacer"></span>
        <span class="q2-nav-badge">synthetic · demo</span>
      </nav>

      <!-- Synthetic data banner -->
      <div class="q2-banner" id="q2-banner" role="status">
        <span class="q2-banner-icon">SYN</span>
        <p class="q2-banner-text">
          <strong>Synthetic data — these breaks are real, these accounts aren't.</strong>
          Every finding in this demo was planted from a pattern that actually appears in production Q2C systems. The account names are fictional. The failure modes are not.
        </p>
        <button class="q2-banner-dismiss" aria-label="Dismiss banner" id="q2-banner-dismiss">×</button>
      </div>

      <!-- Filter bar -->
      <div class="q2-filter-bar" role="toolbar" aria-label="Filter findings">
        <span class="q2-filter-label">Severity</span>
        <button class="q2-filter-pill" data-severity="critical" aria-pressed="false">Critical</button>
        <button class="q2-filter-pill" data-severity="warning" aria-pressed="false">Warning</button>
        <button class="q2-filter-pill" data-severity="at-risk" aria-pressed="false">At Risk</button>
        <div class="q2-filter-divider" aria-hidden="true"></div>
        <span class="q2-filter-label">Object</span>
        <button class="q2-filter-pill" data-type="contract" aria-pressed="false">Contracts</button>
        <button class="q2-filter-pill" data-type="invoice" aria-pressed="false">Invoices</button>
        <button class="q2-filter-pill" data-type="renewal" aria-pressed="false">Renewals</button>
      </div>

      <!-- Main layout: graph + inspector -->
      <div class="q2-layout" id="q2-layout">

        <!-- Graph canvas -->
        <div class="q2-graph-wrap" id="q2-graph-wrap" role="main" aria-label="Quote-to-Cash flow graph">
          <div class="q2-graph-canvas-wrap">
            <svg id="q2-svg" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Q2C flow graph — 5 columns: Opportunity, Quote, Contract, Invoice, Renewal" preserveAspectRatio="none">
              <g id="q2-graph-g"></g>
            </svg>
          </div>

          <!-- Zoom controls -->
          <div class="q2-zoom-controls" aria-label="Zoom controls">
            <button class="q2-zoom-btn" id="q2-zoom-in" aria-label="Zoom in" title="Zoom in">+</button>
            <button class="q2-zoom-btn" id="q2-zoom-reset" aria-label="Reset zoom" title="Reset view" style="font-size:11px">⌖</button>
            <button class="q2-zoom-btn" id="q2-zoom-out" aria-label="Zoom out" title="Zoom out">−</button>
          </div>
        </div>

        <!-- Inspector panel — fully JS-driven -->
        <section class="q2-inspector hidden" id="q2-inspector" aria-label="Record inspector">
          <div class="q2-inspector-header" id="q2-inspector-header">
            <div id="q2-inspector-header-inner">
              <div class="q2-inspector-severity healthy">● SELECT A NODE</div>
              <div class="q2-inspector-title">Click any node in the graph</div>
            </div>
            <button class="q2-inspector-close" id="q2-inspector-close" aria-label="Close inspector">×</button>
          </div>
          <div class="q2-inspector-body" id="q2-inspector-body">
            <p class="q2-inspector-empty">
              Red nodes have active findings. The Crestline Digital contract is pre-selected on load.
            </p>
          </div>
        </section>

      </div><!-- /.q2-layout -->

      <!-- Findings rail -->
      <div class="q2-findings-rail" id="q2-findings-rail" role="navigation" aria-label="Active findings">
        <div class="q2-rail-header">
          <span class="q2-rail-header-text">Active Findings</span>
        </div>
        <div class="q2-findings-list" id="q2-findings-list" role="list" aria-label="Finding cards">
          <!-- Populated by JS -->
          <div style="display:flex;align-items:center;padding:0 1rem;color:oklch(55% 0.01 250);font-size:11px">Loading findings…</div>
        </div>
      </div>

    </div><!-- /#q2-app -->

    <script>
      import '../components/app.ts';
    </script>
  </body>
</html>
